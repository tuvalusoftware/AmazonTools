LLM_PROVIDER=gemini
GOOGLE_API_KEY=AIzaxxxxxxxxxxxx
GEMINI_MODEL=google_genai/gemini-3.5-flash
LLM_VERBOSE=false
BROWSER_HEADLESS=true

CRON_SCHEDULE="0 * * * *"
TIMEZONE="Asia/Ho_Chi_Minh"

TARGET_ASINS="B08N5WRWNW,B09G9FPPHY"
MAX_PAGES=5
REQUEST_DELAY=2.0

OUTPUT_DIR=data
OUTPUT_FORMAT=json

# Amazon credentials — used by the scraper to auto-login
AMAZON_EMAIL=your_email@example.com
AMAZON_PASSWORD=your_password

LOG_LEVEL=INFO
LOG_DIR=logs

# SQLite registry
DB_PATH=data/tracker.db

# Gmail SMTP — create an App Password at https://myaccount.google.com/apppasswords
# Requires 2-Step Verification to be enabled on the sending account.
SMTP__HOST=smtp.gmail.com
SMTP__PORT=587
SMTP__USER=your_email@gmail.com
SMTP__PASSWORD=xxxx xxxx xxxx xxxx   # 16-char Google App Password
SMTP__FROM_ADDR=your_email@gmail.com

# Email digest
EMAIL_DIGEST_CRON=0 8 * * *

# Web UI
WEB_PORT=8080
# WEB_BASE_URL must be set to the host-visible address when running in Docker —
# it is embedded in unsubscribe links inside emails and must be reachable by the
# email recipient's browser.
#   Local dev:   WEB_BASE_URL=http://localhost:8080
#   LAN server:  WEB_BASE_URL=http://192.168.1.10:8080
WEB_BASE_URL=http://localhost:8080
